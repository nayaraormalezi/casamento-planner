# Wedding Planner — environment
# Copy to .env.local and fill secrets from:
# https://supabase.com/dashboard/project/xpkpysdoqquvbpnoxhmn/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://xpkpysdoqquvbpnoxhmn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma (Settings → Database → Connection string URI)
# DATABASE_URL = Transaction pooler (:6543) + ?pgbouncer=true
# DIRECT_URL   = Session pooler (:5432) or Direct connection — required for
#                interactive Prisma transactions (onboarding)
DATABASE_URL="postgresql://postgres.xpkpysdoqquvbpnoxhmn:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xpkpysdoqquvbpnoxhmn:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"


# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# AI (optional)
AI_PROVIDER=
AI_API_KEY=
