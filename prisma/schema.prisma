// Wedding Planner — Prisma Schema (MVP)
// Source of truth for Postgres (Supabase). Money = centavos (Int).
// Auth users live in auth.users; Profile is the public mirror.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum WorkspaceRole {
  owner
  partner
  collaborator
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum WeddingStatus {
  drafting
  planning
  week_of
  done
  archived
}

enum CurrencyCode {
  BRL
}

enum BudgetItemStatus {
  planned
  quoted
  contracted
  partially_paid
  paid
  cancelled
}

enum Flexibility {
  cannot_cut
  can_reduce
  can_remove
}

enum PaymentMethod {
  pix
  credit_card
  debit_card
  boleto
  transfer
  cash
  other
}

enum PaymentPlan {
  lump_sum
  installments
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum VendorStatus {
  researching
  contacted
  quoted
  contracted
  rejected
  cancelled
}

enum TaskPhase {
  m18
  m12
  m9
  m6
  m3
  m1
  d15
  d7
  d3
  day_of
  post
  honeymoon
}

enum TaskStatus {
  todo
  doing
  blocked
  done
  cancelled
}

enum RsvpStatus {
  pending
  yes
  no
  maybe
}

enum AttendanceStatus {
  unknown
  confirmed
  declined
}

enum GuestSide {
  bride
  groom
  both
}

enum GiftStatus {
  available
  reserved
  purchased
  delivered
}

enum DocumentType {
  contract
  receipt
  invoice
  photo
  pdf
  other
}

enum LinkedEntityType {
  budget_item
  vendor
  task
  decision
  guest
  gift
  honeymoon
  wedding
}

enum DecisionStatus {
  pending
  decided
  revisited
}

enum HoneymoonItemType {
  flight
  hotel
  insurance
  itinerary
  document
  other
}

enum HoneymoonItemStatus {
  planned
  reserved
  confirmed
  cancelled
}

enum AiIntent {
  budget_overflow
  what_to_hire
  generate_tasks
  vendor_value
  budget_allocation
}

enum AiSuggestionStatus {
  pending
  accepted
  rejected
  expired
}

enum ActivityAction {
  created
  updated
  deleted
  status_changed
  commented
  uploaded
  invited
  decided
  ai_applied
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

/// Mirror of auth.users — id MUST match auth.users.id
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  invitationsSent     Invitation[]      @relation("InvitationInviter")
  assignedTasks       Task[]            @relation("TaskAssignee")
  taskComments        TaskComment[]
  decisionsMade       Decision[]        @relation("DecisionMaker")
  documentsUploaded   Document[]
  activityLogs        ActivityLog[]
  aiSuggestions       AiSuggestion[]

  @@map("profiles")
}

// ─────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String?   @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships  Membership[]
  invitations  Invitation[]
  weddings     Wedding[]
  activityLogs ActivityLog[]

  @@index([deletedAt])
  @@map("workspaces")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(collaborator)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole    @default(partner)
  token       String           @unique @default(uuid())
  status      InvitationStatus @default(pending)
  invitedById String           @map("invited_by_id") @db.Uuid
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Profile   @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
  @@index([token])
  @@map("invitations")
}

// ─────────────────────────────────────────────
// Wedding project
// ─────────────────────────────────────────────

model Wedding {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  name            String
  partnerOneName  String?       @map("partner_one_name")
  partnerTwoName  String?       @map("partner_two_name")
  weddingDate     DateTime?     @map("wedding_date") @db.Date
  totalBudget     Int           @default(0) @map("total_budget") // centavos
  currency        CurrencyCode  @default(BRL)
  city            String?
  venue           String?
  styleTags       String[]      @default([]) @map("style_tags")
  status          WeddingStatus @default(drafting)
  onboardingDone  Boolean       @default(false) @map("onboarding_done")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budgetItems    BudgetItem[]
  vendors        Vendor[]
  tasks          Task[]
  guests         Guest[]
  gifts          Gift[]
  documents      Document[]
  decisions      Decision[]
  honeymoonItems HoneymoonItem[]
  aiSuggestions  AiSuggestion[]
  categories     BudgetCategory[]
  taskBudgetOptions TaskBudgetOption[]

  @@index([workspaceId])
  @@index([weddingDate])
  @@index([deletedAt])
  @@map("weddings")
}

// ─────────────────────────────────────────────
// Budget
// ─────────────────────────────────────────────

/// Categories can be system defaults (weddingId null) or wedding-specific copies
model BudgetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  weddingId   String?  @map("wedding_id") @db.Uuid
  slug        String
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  wedding Wedding?     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  items   BudgetItem[]

  @@unique([weddingId, slug])
  @@index([weddingId])
  @@map("budget_categories")
}

model BudgetItem {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  weddingId         String          @map("wedding_id") @db.Uuid
  categoryId        String          @map("category_id") @db.Uuid
  subcategory       String?
  description       String
  plannedAmount     Int             @default(0) @map("planned_amount")
  contractedAmount  Int?            @map("contracted_amount")
  paidAmount        Int             @default(0) @map("paid_amount")
  nextPaymentDate   DateTime?       @map("next_payment_date") @db.Date
  vendorId          String?         @map("vendor_id") @db.Uuid
  paymentMethod     PaymentMethod?  @map("payment_method")
  notes             String?
  status            BudgetItemStatus @default(planned)
  priority          Int             @default(3) // 1–5
  flexibility       Flexibility     @default(can_reduce)
  emotionalReturn   Int             @default(3) @map("emotional_return") // 1–5
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  wedding      Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category     BudgetCategory   @relation(fields: [categoryId], references: [id])
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  installments BudgetInstallment[]
  tasks        Task[]
  decisions    Decision[]

  @@index([workspaceId])
  @@index([weddingId, status])
  @@index([weddingId, categoryId])
  @@index([vendorId])
  @@index([nextPaymentDate])
  @@index([priority])
  @@index([deletedAt])
  @@map("budget_items")
}

model BudgetInstallment {
  id           String         @id @default(uuid()) @db.Uuid
  budgetItemId String         @map("budget_item_id") @db.Uuid
  sequence     Int
  amount       Int // centavos
  dueDate      DateTime?      @map("due_date") @db.Date
  paidAt       DateTime?      @map("paid_at")
  paymentMethod PaymentMethod? @map("payment_method")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@unique([budgetItemId, sequence])
  @@index([dueDate])
  @@map("budget_installments")
}

// ─────────────────────────────────────────────
// Vendors
// ─────────────────────────────────────────────

model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  weddingId         String       @map("wedding_id") @db.Uuid
  categorySlug      String       @map("category_slug")
  name              String
  contactName       String?      @map("contact_name")
  phone             String?
  email             String?
  instagram         String?
  website           String?
  quotedAmount      Int?         @map("quoted_amount")
  contractedAmount  Int?         @map("contracted_amount")
  rating            Int? // 1–5
  notes             String?
  status            VendorStatus @default(researching)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  budgetItems BudgetItem[]
  tasks       Task[]
  decisions   Decision[]
  taskBudgetOptions TaskBudgetOption[]

  @@index([workspaceId])
  @@index([weddingId, status])
  @@index([weddingId, categorySlug])
  @@index([deletedAt])
  @@map("vendors")
}

// ─────────────────────────────────────────────
// Tasks / Checklist / Schedule
// ─────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid()) @db.Uuid
  workspaceId   String     @map("workspace_id") @db.Uuid
  weddingId     String     @map("wedding_id") @db.Uuid
  title         String
  description   String?
  phase         TaskPhase  @default(m6)
  categorySlug  String?    @map("category_slug")
  priority      Int        @default(3)
  dueDate       DateTime?  @map("due_date") @db.Date
  startDate     DateTime?  @map("start_date") @db.Date
  status        TaskStatus @default(todo)
  isMilestone   Boolean    @default(false) @map("is_milestone")
  sortOrder     Int        @default(0) @map("sort_order")
  assigneeId    String?    @map("assignee_id") @db.Uuid
  budgetItemId  String?    @map("budget_item_id") @db.Uuid
  vendorId      String?    @map("vendor_id") @db.Uuid
  templateKey   String?    @map("template_key")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  wedding      Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  assignee     Profile?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  budgetItem   BudgetItem?      @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  budgetOptions TaskBudgetOption[]
  comments     TaskComment[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("PrerequisiteTask")

  @@index([workspaceId])
  @@index([weddingId, status])
  @@index([weddingId, phase])
  @@index([weddingId, dueDate])
  @@index([assigneeId])
  @@index([isMilestone])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskBudgetOption {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  weddingId        String        @map("wedding_id") @db.Uuid
  taskId           String        @map("task_id") @db.Uuid
  title            String
  vendorId         String?       @map("vendor_id") @db.Uuid
  vendorName       String?       @map("vendor_name")
  amount           Int           @default(0) // centavos
  notes            String?
  isSelected       Boolean       @default(false) @map("is_selected")
  paymentPlan      PaymentPlan   @default(lump_sum) @map("payment_plan")
  paymentStatus    PaymentStatus @default(unpaid) @map("payment_status")
  paidAmount       Int           @default(0) @map("paid_amount")
  nextPaymentDate  DateTime?     @map("next_payment_date") @db.Date
  installmentCount Int?          @map("installment_count")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  task         Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  wedding      Wedding                 @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendor       Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  installments TaskBudgetInstallment[]

  @@index([workspaceId])
  @@index([weddingId])
  @@index([taskId, isSelected])
  @@map("task_budget_options")
}

model TaskBudgetInstallment {
  id            String         @id @default(uuid()) @db.Uuid
  optionId      String         @map("option_id") @db.Uuid
  sequence      Int
  amount        Int // centavos
  dueDate       DateTime?      @map("due_date") @db.Date
  paidAt        DateTime?      @map("paid_at")
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  option TaskBudgetOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, sequence])
  @@index([dueDate])
  @@map("task_budget_installments")
}

model TaskDependency {
  id              String @id @default(uuid()) @db.Uuid
  taskId          String @map("task_id") @db.Uuid
  dependsOnTaskId String @map("depends_on_task_id") @db.Uuid

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// ─────────────────────────────────────────────
// Guests
// ─────────────────────────────────────────────

model Guest {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  weddingId    String           @map("wedding_id") @db.Uuid
  name         String
  household    String?
  groupName    String?          @map("group_name")
  tableLabel   String?          @map("table_label")
  rsvp         RsvpStatus       @default(pending)
  attendance   AttendanceStatus @default(unknown)
  side         GuestSide        @default(both)
  partySize    Int              @default(1) @map("party_size")
  dietaryTags  String[]         @default([]) @map("dietary_tags")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  gifts   Gift[]

  @@index([workspaceId])
  @@index([weddingId, rsvp])
  @@index([weddingId, groupName])
  @@index([weddingId, tableLabel])
  @@index([deletedAt])
  @@map("guests")
}

// ─────────────────────────────────────────────
// Gifts
// ─────────────────────────────────────────────

model Gift {
  id            String     @id @default(uuid()) @db.Uuid
  workspaceId   String     @map("workspace_id") @db.Uuid
  weddingId     String     @map("wedding_id") @db.Uuid
  name          String
  description   String?
  url           String?
  price         Int? // centavos
  purchasedBy   String?    @map("purchased_by")
  guestId       String?    @map("guest_id") @db.Uuid
  status        GiftStatus @default(available)
  thankYouSent  Boolean    @default(false) @map("thank_you_sent")
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([weddingId, status])
  @@index([deletedAt])
  @@map("gifts")
}

// ─────────────────────────────────────────────
// Honeymoon
// ─────────────────────────────────────────────

model HoneymoonItem {
  id            String              @id @default(uuid()) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  weddingId     String              @map("wedding_id") @db.Uuid
  type          HoneymoonItemType
  title         String
  description   String?
  provider      String?
  confirmationCode String?          @map("confirmation_code")
  startAt       DateTime?           @map("start_at")
  endAt         DateTime?           @map("end_at")
  costAmount    Int?                @map("cost_amount")
  status        HoneymoonItemStatus @default(planned)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([weddingId, type])
  @@index([deletedAt])
  @@map("honeymoon_items")
}

// ─────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────

model Document {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  weddingId    String           @map("wedding_id") @db.Uuid
  name         String
  type         DocumentType     @default(other)
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  storagePath  String           @map("storage_path")
  linkedType   LinkedEntityType? @map("linked_type")
  linkedId     String?          @map("linked_id") @db.Uuid
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")

  wedding    Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  uploadedBy Profile @relation(fields: [uploadedById], references: [id])

  @@index([workspaceId])
  @@index([weddingId, type])
  @@index([linkedType, linkedId])
  @@index([deletedAt])
  @@map("documents")
}

// ─────────────────────────────────────────────
// Decisions
// ─────────────────────────────────────────────

model Decision {
  id                 String         @id @default(uuid()) @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  weddingId          String         @map("wedding_id") @db.Uuid
  title              String
  categorySlug       String?        @map("category_slug")
  status             DecisionStatus @default(pending)
  optionsConsidered  String?        @map("options_considered") // JSON/text
  chosenOption       String?        @map("chosen_option")
  rationale          String?
  dueDate            DateTime?      @map("due_date") @db.Date
  decidedAt          DateTime?      @map("decided_at")
  decidedById        String?        @map("decided_by_id") @db.Uuid
  vendorId           String?        @map("vendor_id") @db.Uuid
  budgetItemId       String?        @map("budget_item_id") @db.Uuid
  emotionalReturn    Int?           @map("emotional_return")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  wedding    Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  decidedBy  Profile?    @relation("DecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  budgetItem BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([weddingId, status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("decisions")
}

// ─────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────

model AiSuggestion {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  weddingId    String             @map("wedding_id") @db.Uuid
  intent       AiIntent
  status       AiSuggestionStatus @default(pending)
  input        Json
  output       Json
  createdById  String             @map("created_by_id") @db.Uuid
  appliedAt    DateTime?          @map("applied_at")
  expiresAt    DateTime?          @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdBy Profile @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
  @@index([weddingId, intent, status])
  @@map("ai_suggestions")
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

model ActivityLog {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  action      ActivityAction
  payload     Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     Profile?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
